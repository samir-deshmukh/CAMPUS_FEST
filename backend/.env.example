# PostgreSQL connection string
DATABASE_URL=postgresql://campusfest:change-me@localhost:5432/campusfest

# Required JWT signing secret. Use a random value of at least 32 characters.
SECURITY_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required administrator credentials. Do not commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Initial QR scanner credentials for a fresh database.
# Leave unset only if scanner login should remain disabled until configured.
SCANNER_USERNAME=scanner
SCANNER_PASSWORD=replace-with-a-strong-scanner-password

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174
